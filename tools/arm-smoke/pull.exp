# vmexpect.py script for run-raid6.sh EXP=pull.exp (review-10-05 R4): pull
# a RAID6 member while a write is going.  Builds the suite's 4-disk v3
# array (tests/v3/common.sh setup_fresh), starts copying 200 MB of random
# data onto it, and 3 s in has QEMU drop disk 2's backend (drive_del d3:
# vbd3 = disk index 2), after which every I/O to it fails with EIO.  The
# data columns are delayed writes, so the failure comes back from the
# buf daemon or the sync, not from write(2).  Then:
#   - the copy and a sync must finish (no endless retry of the dead
#     disk's buffers),
#   - disk 2 must be FAILED,
#   - the file must match, from the cache and, after an unmount that
#     must not hang, from a degraded mount without disk 2.
# Markers are split in the commands so the echoed command lines cannot
# match.
expect login:
send root\r
expect #
send exec /bin/sh\r
expect #
send cd /root/hammer2-tests/v3 && . ./common.sh && (kldstat -q -m hammer2 || kldload hammer2); setup_fresh && check_v3 && echo "SET""UP ok"\r
expect SETUP ok
send dd if=/dev/random of=/var/tmp/src bs=1m count=200 2>/dev/null; sha256 -q /var/tmp/src > /var/tmp/src.sum; echo "SR""C ok"\r
expect SRC ok
send (dd if=/var/tmp/src of=$MNTPT/f bs=1m 2>&1 | tail -1; echo "D""D rc=$?") & sleep 3; echo "PU""LL now"\r
expect PULL now
monitor drive_del d3
monitor info block
send wait; sync; sync; echo "SY""NC done"\r
expect DD rc=
expect SYNC done
send hammer2 -s $MNTPT raid status; disk_state_is 2 FAILED && echo "FAI""LED yes"\r
expect FAILED yes
send [ "$(sha256 -q $MNTPT/f)" = "$(cat /var/tmp/src.sum)" ] && echo "SU""M ok"\r
expect SUM ok
send umount $MNTPT && echo "UM""OUNT ok"\r
expect UMOUNT ok
send mount -t hammer2 "$(degraded_spec 2)@V3TEST" $MNTPT && [ "$(sha256 -q $MNTPT/f)" = "$(cat /var/tmp/src.sum)" ] && echo "CO""LD ok"\r
expect COLD ok
send umount $MNTPT; echo "AL""L done"\r
expect ALL done
send shutdown -p now\r
expect Uptime:

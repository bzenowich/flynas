+  bool Builtin = !DriverArgs.hasArg(options::OPT_nobuiltininc);
+  bool Std = !DriverArgs.hasArg(options::OPT_nostdlibinc);
+
+  // On aarch64 clang is the base compiler, and DragonFly's own <stddef.h>,
+  // <float.h> and friends are complete (the base gcc ships none): they
+  // come first, as for gcc, and the resource directory only adds what
+  // the base headers lack (intrinsics such as <arm_neon.h>).
+  if (getTriple().getArch() == llvm::Triple::aarch64) {
+    if (Std)
+      addExternCSystemInclude(DriverArgs, CC1Args,
+                              concat(D.SysRoot, "/usr/include"));

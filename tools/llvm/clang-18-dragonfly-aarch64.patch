   }
 
-  if (DriverArgs.hasArg(options::OPT_nostdlibinc))
+  if (Builtin)
+    addSystemInclude(DriverArgs, CC1Args, Dir.str());
+
+  if (!Std)
     return;
 
   addExternCSystemInclude(DriverArgs, CC1Args,
                           concat(D.SysRoot, "/usr/include"));
 }
 
+ToolChain::CXXStdlibType
+DragonFly::GetDefaultCXXStdlibType() const {
+  // aarch64 has no base gcc, hence no base libstdc++.
+  if (getTriple().getArch() == llvm::Triple::aarch64)
+    return ToolChain::CST_Libcxx;
+  return ToolChain::CST_Libstdcxx;
+}
+
+void DragonFly::addLibCxxIncludePaths(const llvm::opt::ArgList &DriverArgs,
+                                      llvm::opt::ArgStringList &CC1Args) const {
+  addSystemInclude(DriverArgs, CC1Args,
+                   concat(getDriver().SysRoot, "/usr/include/c++/v1"));
+}
+
 void DragonFly::addLibStdCxxIncludePaths(const llvm::opt::ArgList &DriverArgs,
                                          llvm::opt::ArgStringList &CC1Args) const {

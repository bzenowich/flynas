#!/bin/sh
# Boot an aarch64 kernel under QEMU's "virt" machine: the bring-up target
# for the arm64 port (same Cortex-A72 and GICv2 programming model as the
# Raspberry Pi 4, plus PL011, PSCI and virtio).
#
#   bin/arm-vm [options] [KERNEL]     default KERNEL: tools/kobj/ARM64_VIRT/kernel.bin
#     -g         wait for a debugger: gdbstub on tcp::1234, CPUs halted at reset
#     -s N       CPUs (default 1; -s 4 once SMP works)
#     -m SIZE    RAM (default 1G)
#     -a ARGS    kernel command line (/chosen/bootargs)
#     -t SECS    kill QEMU after SECS (default 120; 0 = no limit)
#     -d FLAGS   QEMU -d tracing (e.g. int,guest_errors), to logs/arm-vm-qemu.log
#
# The serial console is on stdio and is also teed to logs/arm-vm.log.
# There is no KVM for an aarch64 guest on an x86 host, so this is always TCG:
# one host core per guest CPU, flat out.  Keep -s small and the timeout on.
#
# The kernel is loaded with -kernel: QEMU honours the Linux arm64 Image
# header (64-byte header, x0 = DTB physical address, MMU off, EL1 here since
# virtualization=off).  Pass virtualization=on via ARM_VM_MACHINE once the
# EL2 hyp-stub exists.
set -e
REPO="$(cd "$(dirname "$0")/.." && pwd)"
QEMU="${ARM_VM_QEMU:-qemu-system-aarch64}"
MACHINE="${ARM_VM_MACHINE:-virt,gic-version=2}"

gdb=0; smp=1; mem=1G; append=""; timeout=120; dflags=""
while getopts "gs:m:a:t:d:" o; do
    case "$o" in
        g) gdb=1 ;;
        s) smp="$OPTARG" ;;
        m) mem="$OPTARG" ;;
        a) append="$OPTARG" ;;
        t) timeout="$OPTARG" ;;
        d) dflags="$OPTARG" ;;
        *) sed -n '2,/^set -e/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 2 ;;
    esac
done
shift $((OPTIND - 1))
kernel="${1:-$REPO/tools/kobj/ARM64_VIRT/kernel.bin}"
[ -f "$kernel" ] || { echo "arm-vm: no kernel at $kernel" >&2; exit 1; }

mkdir -p "$REPO/logs"
set -- -M "$MACHINE" -cpu cortex-a72 -smp "$smp" -m "$mem" \
    -nographic -no-reboot -kernel "$kernel"
[ -n "$append" ] && set -- "$@" -append "$append"
[ $gdb -eq 1 ] && set -- "$@" -S -gdb tcp:127.0.0.1:1234
[ -n "$dflags" ] && set -- "$@" -d "$dflags" -D "$REPO/logs/arm-vm-qemu.log"
[ $gdb -eq 1 ] && echo "arm-vm: waiting for gdb on 127.0.0.1:1234 (gdb-multiarch: target remote :1234)" >&2

if [ "$timeout" -gt 0 ] && [ $gdb -eq 0 ]; then
    timeout --foreground -k 5 "$timeout" "$QEMU" "$@" 2>&1 | tee "$REPO/logs/arm-vm.log"
else
    "$QEMU" "$@" 2>&1 | tee "$REPO/logs/arm-vm.log"
fi
